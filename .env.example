# Required secrets. Never commit a real .env file.
TELEGRAM_BOT_TOKEN=replace_with_new_botfather_token
OPENAI_API_KEY=replace_with_openai_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_new_server_only_supabase_secret_key

# Private admin dashboard. /admin stays disabled until both are configured.
# Use a unique random password of at least 16 characters and HTTPS only.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# BuildWise Pro preview. Keep disabled unless running a reviewed local/preview environment.
# Use unique random secrets; do not reuse admin, Telegram, Supabase, or OpenAI credentials.
BUILDWISE_PRO_ENABLED=false
BUILDWISE_PRO_ACCESS_KEY=replace_with_unique_random_preview_key_24_chars_min
BUILDWISE_PRO_SESSION_SECRET=replace_with_unique_random_session_secret_32_chars_min
BUILDWISE_PRO_SESSION_TTL_SECONDS=28800
BUILDWISE_PRO_DAILY_REQUEST_LIMIT=10
BUILDWISE_PRO_MAX_FILE_SIZE_MB=10

# Use polling locally. Production can use webhook mode to ensure one authoritative
# Telegram receiver. Railway auto-detects RAILWAY_PUBLIC_DOMAIN; elsewhere set
# TELEGRAM_WEBHOOK_BASE_URL to the public HTTPS origin, without a trailing slash.
RUNTIME_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
INTERNAL_CRON_SECRET=

# OpenAI
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_IMAGE_DETAIL=auto
OPENAI_TIMEOUT_SECONDS=90

# Supabase Storage. Keep this aligned with migrations/001_buildwise_mvp.sql.
SUPABASE_STORAGE_BUCKET=buildwise-uploads
MAX_FILE_SIZE_MB=10

# Product controls
HISTORY_TURNS=8
DAILY_AI_REQUEST_LIMIT=20
REQUEST_COOLDOWN_SECONDS=2
REMINDER_POLL_SECONDS=60

# Optional comma-separated Telegram numeric IDs. Empty allows public access.
ALLOWED_USER_IDS=

# Railway and Google Cloud provide PORT, or use these defaults locally.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
